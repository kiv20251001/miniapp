{
  "pages": [
    {
      "path": "pages/home/index",
      "style": {
        "navigationBarTitleText": "Uday 家庭课表",
        "componentPlaceholder": {
          "calendar-view": "view",
          "courses-view": "view",
          "stats-view": "view"
        }
      }
    },
    { "path": "pages/login/index", "style": { "navigationBarTitleText": "登录" } }
  ],
  "subPackages": [
    {
      "root": "subpages",
      "pages": [
        { "path": "bills/index", "style": { "navigationBarTitleText": "本周账单" } },
        { "path": "course-edit/index", "style": { "navigationBarTitleText": "编辑课程" } },
        { "path": "course-bills/index", "style": { "navigationBarTitleText": "课程账单" } },
        { "path": "expense-edit/index", "style": { "navigationBarTitleText": "账单" } },
        { "path": "family/index", "style": { "navigationBarTitleText": "家庭" } },
        { "path": "toolbox/index", "style": { "navigationBarTitleText": "工具箱" } },
        { "path": "stats/index", "style": { "navigationBarTitleText": "课程统计" } },
        { "path": "copybook/index", "style": { "navigationBarTitleText": "字帖生成" } },
        { "path": "maths/index", "style": { "navigationBarTitleText": "计算题生成" } },
        { "path": "maths/sheet", "style": { "navigationBarTitleText": "计算题" } },
        { "path": "clock/index", "style": { "navigationBarTitleText": "认识时钟" } },
        { "path": "pizza/index", "style": { "navigationBarTitleText": "认识分数" } }
      ]
    },
    {
      "root": "subsolar",
      "pages": [
        {
          "path": "index",
          "style": { "navigationBarTitleText": "3D 太阳系", "disableScroll": true }
        },
        {
          "path": "cube/index",
          "style": { "navigationBarTitleText": "3D 几何体" }
        }
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": { "network": "all", "packages": ["subpages"] },
    "subpages/toolbox/index": { "network": "wifi", "packages": ["subsolar"] }
  },
  "globalStyle": {
    "navigationStyle": "custom",
    "backgroundColor": "#F3F4FB",
    "backgroundColorTop": "#F3F4FB",
    "backgroundColorBottom": "#F3F4FB",
    "backgroundTextStyle": "dark"
  }
}
